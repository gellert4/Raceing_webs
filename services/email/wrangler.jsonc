{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flowstate-email",
  "main": "worker.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGIN": "https://gellert4.github.io",
    "SITE_URL": "https://gellert4.github.io/Raceing_webs/",
    "REGISTRATION_ENABLED": "false",
    "NOTICE_VERSION": "2026-09-16-draft-3",
    "BREVO_LIST_EN": "0", "BREVO_LIST_HU": "0", "BREVO_LIST_DE": "0",
    "BREVO_TEMPLATE_EN": "0", "BREVO_TEMPLATE_HU": "0", "BREVO_TEMPLATE_DE": "0"
  },
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "47001", "simple": { "limit": 10, "period": 60 } },
    { "name": "EMAIL_LIMITER", "namespace_id": "47002", "simple": { "limit": 1, "period": 60 } }
  ]
}
